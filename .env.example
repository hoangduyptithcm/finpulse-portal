# Database Connection (Supabase Postgres or Local Docker Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/finpulse_db?schema=public"

# NextAuth / Auth.js Configuration
# LƯU Ý QUAN TRỌNG KHI DEPLOY VỚI DOMAIN:
# 1. Đổi NEXTAUTH_URL và AUTH_URL thành domain chính xác (VD: https://finpulse.vn).
#    Nếu để IP VPS (http://103.121.91.234) thì mỗi khi đăng nhập NextAuth sẽ redirect đá về IP!
# 2. Đặt AUTH_TRUST_HOST=true để NextAuth tin tưởng proxy (Nginx).
NEXTAUTH_SECRET="finpulse_super_secret_key_change_in_production_2026"
NEXTAUTH_URL="https://yourdomain.com"
AUTH_URL="https://yourdomain.com"
AUTH_TRUST_HOST=true

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@finpulse.vn"
ADMIN_PASSWORD="YourSecurePassword"

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Keep-Alive Cron Security (Tùy chọn: dùng để bảo vệ route /api/cron/keep-alive)
CRON_SECRET="your_custom_cron_secret_token"
